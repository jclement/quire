# Copy to .env and fill in. Nothing here is read by quire directly except the
# QUIRE_* values; the rest configures the Tailscale sidecar.

# The node name on your tailnet. quire ends up at
# https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=quire

# Mint at https://login.tailscale.com/admin/settings/keys — needed on first
# boot only; the node identity then persists in ./ts-state.
TS_AUTHKEY=tskey-auth-REPLACE-ME

# ACL tags applied to the node. Drop this if your tailnet does not use tags.
TS_TAGS=tag:container

# MUST match the URL above exactly — passkeys bind to this hostname, and
# share links and OAuth discovery are built from it.
QUIRE_BASE_URL=https://quire.your-tailnet.ts.net

# passkey is right for a human. token-only for a headless, agent-driven box.
QUIRE_AUTH_MODE=passkey

# latest = newest release, edge = today's main, main-<sha> = one commit.
QUIRE_TAG=latest
