# Copy to .env and fill in.

# Your Gatecrash server's tunnel endpoint and its SSH host-key fingerprint
# (both shown in the Gatecrash admin panel; the fingerprint is what stops a
# man in the middle impersonating your tunnel server).
GATECRASH_SERVER=tunnel.example.com:51234
GATECRASH_HOST_KEY=SHA256:REPLACE-ME

# Create a tunnel in the Gatecrash admin panel routed to your hostname, then
# paste its token here as name:secret.
GATECRASH_TOKEN=quire:REPLACE-ME
