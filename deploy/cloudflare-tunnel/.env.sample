# Copy to .env and fill in.

# From the Zero Trust dashboard when you create the tunnel. This is a
# credential — do not commit .env.
CF_TUNNEL_TOKEN=eyJREPLACE-ME

# The public hostname you routed to http://quire:8321, exactly as browsers
# see it. Passkeys bind to this hostname; share links and OAuth discovery
# are built from it. Changing it later means re-registering passkeys.
QUIRE_BASE_URL=https://notes.example.com

# This URL is on the public internet, so quire's own auth is what protects
# it. passkey is also the only mode in which OAuth consent can be approved,
# which claude.ai connectors require.
QUIRE_AUTH_MODE=passkey

# latest = newest release, edge = today's main, main-<sha> = one commit.
QUIRE_TAG=latest
