# Copy to mise.local.toml (gitignored) to make `mise run dev` serve YOUR real
# data. Everything here overrides mise.toml's [env].
#
# Dev always runs on loopback with auth off: http://localhost:5173 is Vite
# with HMR, proxying to the Go server on :8321. To exercise the parts that
# need a real public URL (passkeys, share links, OAuth discovery), put a
# tunnel in front of :8321 — `tailscale serve 8321`, or `cloudflared tunnel
# --url http://localhost:8321` — and set QUIRE_BASE_URL to the URL it hands
# you. Nothing in quire knows or cares which one you used.

[env]
# Real data instead of the scratch vault (vault lives at <data>/vault):
QUIRE_DATA_DIR = "{{env.HOME}}/.data/quire"

# Only when fronting dev with a tunnel — this is the URL share links, the
# WebAuthn RP ID, and OAuth discovery are all built from:
# QUIRE_BASE_URL = "https://quire-dev.your-tailnet.ts.net"

# Optional: morning digest email (any provider's SMTP endpoint):
# QUIRE_SMTP_HOST = "smtp.mailgun.org"
# QUIRE_SMTP_USER = "postmaster@mg.example.com"
# QUIRE_SMTP_PASS = "…"
# QUIRE_SMTP_FROM = "quire@example.com"
# QUIRE_DIGEST_TO = "you@example.com"
# QUIRE_DIGEST_TIME = "06:30"

# The vault is a local git repo with debounced auto-commits by default;
# uncomment to opt out:
# QUIRE_GIT = "false"
